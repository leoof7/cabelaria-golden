# Copie este arquivo para .env.local e preencha com os dados do projeto
# Supabase (Project Settings > API). Este arquivo (.env.example) vai para
# o Git como documentação — o .env.local NUNCA vai (está no .gitignore).
#
# NEXT_PUBLIC_* fica visível no navegador do usuário. Por isso aqui só
# entra a chave "anon" (pública). A chave "service_role" nunca deve ser
# usada neste projeto.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
